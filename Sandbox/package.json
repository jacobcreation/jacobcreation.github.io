{
  "name": "jacobcreation-sandbox",
  "version": "1.0.0",
  "description": "JacobCreation Sandbox - an Electron + Node.js desktop app",
  "main": "main.js",
  "author": "Jacob",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.jacobcreation.sandbox",
    "productName": "JacobCreation Sandbox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons"
    }
  },
  "dependencies": {
    "electron": "^30.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0"
  }
}


#cloud-config
hostname: ubuntu-browser-vm
manage_etc_hosts: true
ssh_pwauth: true
disable_root: true

users:
  - default
  - name: ubuntu
    gecos: Ubuntu Browser VM
    shell: /bin/bash
    groups: [adm, sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: ubuntu

chpasswd:
  list: |
    ubuntu:ubuntu
  expire: false

write_files:
  - path: /etc/motd
    permissions: "0644"
    content: |
      Ubuntu Browser VM
      Login with username: ubuntu
      Password: ubuntu

runcmd:
  - [ sh, -c, "sed -i 's/^PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config || true" ]
  - [ sh, -c, "systemctl restart ssh || true" ]
